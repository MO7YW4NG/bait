# Base Sepolia ONLY (eip155:84532). NEVER configure a mainnet wallet here.
RPC_URL=https://sepolia.base.org
# Replace placeholders locally in .env; never commit a real private key.
DECOY_PRIVATE_KEY=
CUSTOMER_PRIVATE_KEY=
MERCHANT_PAYTO=
FACILITATOR_URL=https://x402.org/facilitator
MOCK_FACILITATOR=0

# OpenAI-compatible GMI Cloud. Model IDs must be verified against /v1/models.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
CUSTOMER_MODEL=
JUDGE_MODEL=

# HTTP services
MERCHANT_URL=http://localhost:4021
FEED_URL=http://localhost:4030
GUARD_MIN_SCORE=0.6
MAX_PRICE_PER_CALL_USDC=0.10

# Stripe test mode only; optional stretch feature
STRIPE_SECRET_KEY=
